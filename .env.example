# ─────────────────────────────────────────────────────────────────────────────
# Configuration de MediCare31 — copier en .env et adapter avant la mise en prod.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données ───────────────────────────────────────────────────────────
POSTGRES_USER=medicare_admin
POSTGRES_PASSWORD=changez-moi-en-production
POSTGRES_DB=medicaredb

# Format : postgresql://utilisateur:motdepasse@hote:5432/base
# En Docker, l'hôte est "db". En production, l'hôte est celui de votre
# base gérée (RDS, Cloud SQL, PostgreSQL managé...).
DATABASE_URL=postgresql://medicare_admin:changez-moi-en-production@db:5432/medicaredb

# ── Sécurité JWT ──────────────────────────────────────────────────────────────
# Générer une valeur aléatoire d'au moins 32 caractères, par exemple :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=changez-moi-par-une-valeur-aleatoire-de-64-caracteres
ALGORITHM=HS256
# Durée de validité d'une session (minutes). 1440 = 24 h
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Application ───────────────────────────────────────────────────────────────
# "prod" active la restitution détaillée des erreurs côté API.
ENV=prod
# Origines autorisées à appeler l'API, séparées par des virgules.
ALLOWED_ORIGINS=["https://votre-domaine.fr", "https://www.votre-domaine.fr"]
# URL publique du site : sert aux liens des e-mails (vérification, reset).
APP_BASE_URL=https://votre-domaine.fr

# ── E-mails (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.votre-fournisseur.fr
SMTP_PORT=587
SMTP_FROM=noreply@votre-domaine.fr
SMTP_USER=
SMTP_PASSWORD=
# false uniquement pour un serveur local de développement (MailHog).
SMTP_USE_TLS=true

# ── Stockage des pièces jointes et documents ──────────────────────────────────
# Chemin dans le conteneur ; le volume Docker "uploads" y est monté.
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_KB=10240
